# Copie este arquivo para .env para rodar localmente (npm run dev).
# Na Hostinger, cadastre estas variáveis no painel do app Node.js. NUNCA suba o .env para o GitHub.

NODE_ENV=production

# --- Dados do site ---
SITE_NAME=Cãomaradas Creche & Hotel
SITE_TAGLINE=Creche e hotel para cães em Pontal do Paraná. Onde seu pet se sente em casa
# Somente números, com DDI + DDD (ex: 5541984744751)
WHATSAPP_NUMBER=5541984744751
INSTAGRAM_URL=https://www.instagram.com/caomaradascrechehotel/
ADDRESS=Av. Elis Regina, 549 — Balneário Primavera, Pontal do Paraná - PR, 83255-000
PHONE_DISPLAY=(41) 98474-4751
VET_INSTAGRAM_URL=https://www.instagram.com/annazavataro.vet/

# --- Banco de dados MySQL (criado no hPanel) ---
# Dentro da Hostinger use SEMPRE 127.0.0.1 (não "localhost" e não o host srvXXXX).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=usuario_do_banco
DB_PASSWORD=senha_do_banco
DB_NAME=nome_do_banco

# --- Painel administrativo (/admin) ---
ADMIN_USER=admin
ADMIN_PASSWORD=troque-por-uma-senha-forte
# Texto aleatório com 32+ caracteres (usado para assinar o login)
SESSION_SECRET=troque-por-um-texto-aleatorio-bem-longo-123456
