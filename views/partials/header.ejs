<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= locals.title ? locals.title + ' · ' : '' %><%= site.name %></title>
  <meta name="description" content="<%= locals.description || site.tagline %>">
  <meta name="theme-color" content="#4a7f62">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600&family=Nunito:wght@400;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand">
      <% if (site.logo) { %>
        <img src="<%= site.logo %>" alt="<%= site.name %>" class="brand-logo">
      <% } else { %>
        <span class="brand-paw" aria-hidden="true">🐾</span>
      <% } %>
      <span class="brand-name"><%= site.name %></span>
    </a>
    <button class="nav-toggle" aria-label="Abrir menu" aria-expanded="false" data-nav-toggle>
      <span></span><span></span><span></span>
    </button>
    <nav class="nav" data-nav>
      <a href="/#servicos">Serviços</a>
      <a href="/#como-funciona">Como funciona</a>
      <a href="/#contato">Contato</a>
      <a href="/agendar" class="btn btn-small">Agendar</a>
    </nav>
  </div>
</header>
<main>
