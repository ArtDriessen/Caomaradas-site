<% if (!currentPath.startsWith('/admin')) { %>
<section class="section map-section" id="como-chegar">
  <div class="container">
    <h2>Como <span class="hl">chegar</span></h2>
    <p class="section-sub"><%= site.address %></p>
    <div class="map-frame">
      <iframe title="Mapa com a localização da Cãomaradas" src="https://www.google.com/maps?q=<%= encodeURIComponent(site.mapQuery) %>&output=embed" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
    </div>
    <div class="center map-actions">
      <a href="https://www.google.com/maps/dir/?api=1&destination=<%= encodeURIComponent(site.mapQuery) %>" class="btn" target="_blank" rel="noopener">Como chegar</a>
      <a href="https://www.google.com/maps/search/?api=1&query=<%= encodeURIComponent(site.mapQuery) %>" class="btn btn-outline" target="_blank" rel="noopener">Abrir no Google Maps</a>
    </div>
  </div>
</section>
<% } %>
</main>
<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <% if (site.logo) { %><img src="<%= site.logo %>" alt="" class="footer-logo"><% } %>
      <strong>Cãomaradas Creche &amp; Hotel</strong>
      <p>Onde seu pet se sente em casa.</p>
      <div class="footer-social">
        <% if (site.instagram) { %><a href="<%= site.instagram %>" target="_blank" rel="noopener">Instagram</a><% } %>
        <a href="<%= waLink() %>" target="_blank" rel="noopener">WhatsApp</a>
      </div>
    </div>
    <div>
      <h4>Serviços</h4>
      <ul>
        <li><a href="/servicos/hotel">Hotel</a></li>
        <li><a href="/servicos/creche">Creche e day use</a></li>
        <li><a href="/agendar">Pré-reserva do hotel</a></li>
        <li><a href="/dayuse">Agendar day use</a></li>
        <li><a href="/avaliacao">Agendar avaliação</a></li>
      </ul>
    </div>
    <div>
      <h4>A Cãomaradas</h4>
      <ul>
        <li><a href="/#quem-somos">Quem somos</a></li>
        <li><a href="/#requisitos">Requisitos</a></li>
        <li><a href="/#contato">Contato</a></li>
      </ul>
    </div>
    <div>
      <h4>Onde estamos</h4>
      <p><%= site.address %></p>
      <p><a href="/#como-chegar">Ver no mapa</a></p>
      <p><a href="<%= waLink() %>" target="_blank" rel="noopener"><%= site.phoneDisplay %></a></p>
      <p class="footer-hours">Day use: das 9h às 18h30</p>
    </div>
  </div>
  <div class="container footer-copy">&copy; <%= new Date().getFullYear() %> Cãomaradas Creche &amp; Hotel. Todos os direitos reservados.</div>
</footer>

<a href="<%= waLink('Olá! Vim pelo site e gostaria de mais informações.') %>" class="wa-float" target="_blank" rel="noopener" aria-label="Falar no WhatsApp">
  <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor" aria-hidden="true"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38a9.9 9.9 0 0 0 4.74 1.21h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2zm5.8 14.08c-.24.68-1.4 1.3-1.93 1.38-.5.07-1.13.1-1.82-.12-.42-.13-.96-.31-1.65-.6-2.9-1.25-4.8-4.17-4.94-4.37-.14-.19-1.18-1.57-1.18-3 0-1.42.75-2.12 1.01-2.41.27-.29.58-.36.78-.36l.56.01c.18.01.42-.07.66.5.24.59.83 2.03.9 2.18.07.15.12.32.02.51-.1.2-.15.32-.29.49-.15.17-.31.38-.44.51-.15.15-.3.31-.13.6.17.29.76 1.25 1.63 2.03 1.12 1 2.07 1.31 2.36 1.46.29.15.46.12.63-.07.17-.2.73-.85.93-1.14.19-.29.39-.24.66-.15.27.1 1.7.8 1.99.95.29.15.49.22.56.34.07.12.07.7-.17 1.38z"/></svg>
</a>

<script src="/js/app.js" defer></script>
</body>
</html>
