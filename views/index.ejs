<%- include('partials/header') %>

<section class="hero">
  <div class="container hero-inner">
    <div class="hero-text">
      <p class="eyebrow">Creche e Hotel · Pontal do Paraná</p>
      <h1>Onde seu pet se sente em casa</h1>
      <p class="lead">Na Cãomaradas, seu cão é cuidado com carinho enquanto você trabalha ou viaja. Faça o pedido de agendamento em poucos minutos e confirmamos tudo pelo WhatsApp.</p>
      <div class="hero-actions">
        <a href="/agendar" class="btn">Agendar hospedagem</a>
        <a href="/agendar?servico=creche" class="btn btn-outline">Agendar creche</a>
      </div>
    </div>
    <div class="hero-art" aria-hidden="true">
      <% if (site.logo) { %>
        <img src="<%= site.logo %>" alt="" class="hero-logo">
      <% } else { %>
        <div class="hero-paw">🐶</div>
      <% } %>
    </div>
  </div>
</section>

<section id="servicos" class="section">
  <div class="container">
    <h2>Nossos serviços</h2>
    <p class="section-sub">Escolha o que combina com a rotina do seu cão.</p>
    <div class="cards">
      <article class="card">
        <div class="card-icon">🏡</div>
        <h3>Hospedagem</h3>
        <p>Diárias para o seu cão ficar bem acolhido, como em casa, enquanto você viaja ou precisa se ausentar.</p>
        <a href="/agendar?servico=hospedagem" class="card-link">Agendar hospedagem →</a>
      </article>
      <article class="card">
        <div class="card-icon">🎾</div>
        <h3>Creche</h3>
        <p>Um dia de atividades, convivência com os amigos e gasto de energia, com entrada e saída no mesmo dia.</p>
        <a href="/agendar?servico=creche" class="card-link">Agendar creche →</a>
      </article>
      <article class="card">
        <div class="card-icon">🩺</div>
        <h3>Veterinária</h3>
        <p>Acompanhamento veterinário com a Dra. Anna Zavataro, uma das responsáveis pelo espaço.</p>
        <% if (site.vetInstagram) { %><a href="<%= site.vetInstagram %>" class="card-link" target="_blank" rel="noopener">Conhecer o trabalho →</a><% } %>
      </article>
      <article class="card">
        <div class="card-icon">🐕‍🦺</div>
        <h3>Pet sitter</h3>
        <p>Cuidado com o seu pet no conforto da rotina dele. Fale com a gente pelo WhatsApp para combinar os detalhes.</p>
        <a href="<%= waLink('Olá! Gostaria de saber mais sobre o serviço de pet sitter.') %>" class="card-link" target="_blank" rel="noopener">Perguntar no WhatsApp →</a>
      </article>
    </div>
  </div>
</section>

<section id="quem-somos" class="section section-alt">
  <div class="container team">
    <img src="/img/donas.jpg" alt="Bia e Anna, sócias da Cãomaradas" class="team-photo" loading="lazy">
    <div>
      <h2>Quem cuida do seu cão</h2>
      <p class="section-sub">A Cãomaradas é um negócio de duas sócias que amam cães, e o seu pet fica nas mãos delas.</p>
      <ul class="team-list">
        <li><strong>Bia</strong> · Pet sitter<br><span>Cuidado de perto, com atenção à rotina e ao jeito de cada cão.</span></li>
        <li><strong>Anna Zavataro</strong> · Médica-veterinária<br><span>Cuidado de quem entende de saúde e bem-estar animal.</span></li>
      </ul>
    </div>
  </div>
</section>

<section id="como-funciona" class="section">
  <div class="container">
    <h2>Como funciona</h2>
    <ol class="steps">
      <li><span class="step-n">1</span><div><h3>Preencha o pedido</h3><p>Dados do tutor, do cão e as datas desejadas.</p></div></li>
      <li><span class="step-n">2</span><div><h3>Confirmamos pelo WhatsApp</h3><p>Analisamos o pedido e retornamos para alinhar os detalhes.</p></div></li>
      <li><span class="step-n">3</span><div><h3>Traga o seu cão</h3><p>Na data combinada, é só chegar. A gente cuida do resto.</p></div></li>
    </ol>
    <div class="center"><a href="/agendar" class="btn">Fazer meu pedido</a></div>
  </div>
</section>

<section id="contato" class="section section-alt">
  <div class="container contact">
    <div>
      <h2>Fale com a gente</h2>
      <p class="section-sub">Dúvidas sobre valores, vagas ou regras? Mande uma mensagem e respondemos pelo WhatsApp.</p>
      <ul class="contact-list">
        <li>📍 <%= site.address %> · <a href="https://www.google.com/maps/search/?api=1&query=<%= encodeURIComponent(site.address) %>" target="_blank" rel="noopener">Ver no mapa</a></li>
        <li>💬 <a href="<%= waLink() %>" target="_blank" rel="noopener"><%= site.phoneDisplay %></a></li>
        <% if (site.instagram) { %><li>📸 <a href="<%= site.instagram %>" target="_blank" rel="noopener">@caomaradascrechehotel</a></li><% } %>
      </ul>
    </div>
    <form class="card form-card" data-whatsapp-form data-wa="<%= site.whatsapp %>">
      <label>Seu nome
        <input type="text" name="name" maxlength="80" required>
      </label>
      <label>Mensagem
        <textarea name="message" rows="4" maxlength="500" required></textarea>
      </label>
      <button type="submit" class="btn btn-full">Enviar pelo WhatsApp</button>
      <p class="hint">Ao enviar, o WhatsApp abre com a mensagem pronta.</p>
    </form>
  </div>
</section>

<%- include('partials/footer') %>
