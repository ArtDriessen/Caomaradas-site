<%- include('partials/header') %>

<section class="hero">
  <div class="hero-deco" aria-hidden="true"><span class="sun"></span><span class="cloud c1"></span><span class="cloud c2"></span><span class="cloud c3"></span></div>
  <div class="container hero-inner">
    <div class="hero-text">
      <p class="eyebrow">Creche e Hotel · Pontal do Paraná</p>
      <h1>Onde seu pet se sente <span class="hl">em casa</span></h1>
      <p class="lead">Na Cãomaradas, seu cão se diverte, socializa e recebe todo o cuidado que merece, enquanto você trabalha ou viaja.</p>
      <div class="hero-actions">
        <a href="<%= waLink('Olá! Vim pelo site e gostaria de mais informações.') %>" class="btn" target="_blank" rel="noopener">Falar no WhatsApp</a>
        <a href="/agendar" class="btn btn-outline">Pré-reserva do hotel</a>
      </div>
    </div>
    <div class="hero-photo">
      <img src="/img/logo-praia.jpg" alt="Logo da Cãomaradas Creche e Hotel em frente ao mar" width="900" height="878">
    </div>
  </div>
  <div class="waves" aria-hidden="true"><i></i><i></i><i></i></div>
</section>

<section id="servicos" class="section">
  <div class="container">
    <h2>Nossos <span class="hl">serviços</span></h2>
    <p class="section-sub">Escolha o que combina com a rotina do seu cão.</p>
    <div class="svc-grid">
      <article class="svc-card">
        <img src="/img/card-hotel.jpg" alt="Dois cães yorkshire descansando em uma almofada" loading="lazy" width="960" height="600">
        <div class="svc-body">
          <h3>Hotel</h3>
          <p>Cuidado, conforto e segurança para o seu pet. Ambiente climatizado, monitorado e com supervisão constante.</p>
          <p class="svc-price">Diária de <strong>R$ 170,00</strong> <span>(a partir do 2º hóspede: R$ 150,00 cada)</span></p>
          <div class="svc-actions">
            <a href="/servicos/hotel" class="btn btn-small">Conhecer o hotel</a>
            <a href="/agendar" class="btn btn-outline btn-small">Pré-reserva</a>
          </div>
        </div>
      </article>
      <article class="svc-card">
        <img src="/img/card-creche.jpg" alt="Um maltês e um yorkshire deitados lado a lado na varanda da creche" loading="lazy" width="960" height="600">
        <div class="svc-body">
          <h3>Creche e day use</h3>
          <p>Diversão e bem-estar para o seu pet por um dia, das 9h às 18h30. Antes de começar, agende uma avaliação.</p>
          <p class="svc-price">Day use: <strong>R$ 100,00</strong> <span>por pet · creche: agende uma avaliação</span></p>
          <div class="svc-actions">
            <a href="/servicos/creche" class="btn btn-small">Conhecer a creche</a>
            <a href="/dayuse" class="btn btn-outline btn-small">Agendar day use</a>
            <a href="/avaliacao" class="btn btn-outline btn-small">Avaliação</a>
          </div>
        </div>
      </article>
    </div>

    <div class="cards cards-small">
      <article class="card">
        <div class="card-icon">🩺</div>
        <h3>Veterinária</h3>
        <p>Atendimento domiciliar com a Dra. Anna Zavataro, médica-veterinária e uma das responsáveis pelo espaço.</p>
        <% if (site.vetInstagram) { %><a href="<%= site.vetInstagram %>" class="card-link" target="_blank" rel="noopener">Conhecer o trabalho →</a><% } %>
      </article>
      <article class="card">
        <div class="card-icon">🐕‍🦺</div>
        <h3>Pet sitter</h3>
        <p>Com a Beatriz Brotto: cuidado com o seu pet no conforto da rotina dele, inclusive cuidado em casa. Fale com a gente para combinar os detalhes.</p>
        <a href="<%= waLink('Olá! Gostaria de saber mais sobre o serviço de pet sitter.') %>" class="card-link" target="_blank" rel="noopener">Perguntar no WhatsApp →</a>
      </article>
    </div>
  </div>
  <div class="paw-trail" aria-hidden="true"></div>
</section>

<section id="requisitos" class="section section-alt">
  <div class="container">
    <h2>Tudo para garantir a <span class="hl">segurança</span> e o bem-estar de todos</h2>
    <p class="section-sub">Requisitos para hospedar ou frequentar a creche:</p>
    <%- include('partials/requisitos') %>
  </div>
</section>

<section class="section" id="galeria">
  <div class="container">
    <h2>Nossos <span class="hl">hóspedes</span></h2>
    <p class="section-sub">Alguns dos amigos que já passaram por aqui.</p>
    <div class="gallery">
      <img src="/img/g-ball.jpg" alt="Yorkshire com uma bolinha vermelha na boca" loading="lazy" width="600" height="600">
      <img src="/img/g-beagle.jpg" alt="Beagle com um brinquedo vermelho na boca" loading="lazy" width="600" height="600">
      <img src="/img/g-pom.jpg" alt="Spitz alemão de olhos fechados tomando sol" loading="lazy" width="600" height="600">
      <img src="/img/g-grey.jpg" alt="Cãozinho cinza olhando para cima" loading="lazy" width="600" height="600">
    </div>
  </div>
</section>
<section id="quem-somos" class="section">
  <div class="container team">
    <img src="/img/donas.jpg" alt="Beatriz e Anna, sócias da Cãomaradas" class="team-photo" loading="lazy">
    <div>
      <h2>Quem cuida do <span class="hl">seu cão</span></h2>
      <p class="section-sub">A Cãomaradas é um negócio de duas sócias que amam cães, e o seu pet fica nas mãos delas.</p>
      <ul class="team-list">
        <li><strong>Beatriz Brotto</strong> · Pet sitter<br><span>Também faz cuidado em casa, com atenção à rotina e ao jeito de cada cão.</span></li>
        <li><strong>Anna Zavataro</strong> · Médica-veterinária<br><span>Atendimento domiciliar, com o cuidado de quem entende de saúde e bem-estar animal.</span></li>
      </ul>
    </div>
  </div>
</section>

<%- include('partials/cta-final', { cta: {
  title: 'Seu pet merece um lugar para',
  highlight: 'chamar de casa',
  text: 'Faça a pré-reserva do hotel ou agende uma avaliação para a creche. Confirmamos tudo pelo WhatsApp.',
  button: 'Fazer pré-reserva',
  href: '/agendar',
  image: '/img/cta-1.jpg'
} }) %>

<section id="contato" class="section section-alt">
  <div class="container contact">
    <div>
      <h2>Fale com a <span class="hl">gente</span></h2>
      <p class="section-sub">Dúvidas sobre valores, vagas ou regras? Mande uma mensagem e respondemos pelo WhatsApp.</p>
      <ul class="contact-list">
        <li>📍 <%= site.address %> · <a href="https://www.google.com/maps/search/?api=1&query=<%= encodeURIComponent(site.address) %>" target="_blank" rel="noopener">Ver no mapa</a></li>
        <li>💬 <a href="<%= waLink() %>" target="_blank" rel="noopener"><%= site.phoneDisplay %></a></li>
        <% if (site.instagram) { %><li>📸 <a href="<%= site.instagram %>" target="_blank" rel="noopener">@caomaradascrechehotel</a></li><% } %>
      </ul>
    </div>
    <form class="card form-card" data-whatsapp-form data-wa="<%= site.whatsapp %>">
      <label>Seu nome
        <input type="text" name="name" maxlength="80" required>
      </label>
      <label>Mensagem
        <textarea name="message" rows="4" maxlength="500" required></textarea>
      </label>
      <button type="submit" class="btn btn-full">Enviar pelo WhatsApp</button>
      <p class="hint">Ao enviar, o WhatsApp abre com a mensagem pronta.</p>
    </form>
  </div>
</section>

<%- include('partials/footer') %>
