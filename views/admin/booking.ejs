<%- include('../partials/header') %>

<section class="section">
  <div class="container narrow">
    <p><a href="/admin">← Voltar aos agendamentos</a></p>
    <h1>Pedido #<%= booking.id %> <span class="badge badge-<%= booking.status %>"><%= labels.status[booking.status] %></span></h1>

    <% if (locals.saved) { %><div class="alert alert-ok" role="status">Alterações salvas.</div><% } %>

    <div class="card details">
      <dl>
        <dt>Serviço</dt><dd><%= labels.service[booking.service] %></dd>
        <dt>Período</dt>
        <dd><% if (booking.service === 'creche') { %><%= fmtDate(booking.check_in) %><% } else { %><%= fmtDate(booking.check_in) %> até <%= fmtDate(booking.check_out) %><% } %></dd>
        <dt>Tutor</dt><dd><%= booking.tutor_name %></dd>
        <dt>WhatsApp</dt>
        <dd><a href="<%= 'https://wa.me/' + booking.whatsapp + '?text=' + encodeURIComponent('Olá, ' + booking.tutor_name + '! Sobre o pedido de agendamento para ' + booking.pet_name + ': ') %>" target="_blank" rel="noopener"><%= booking.whatsapp %></a></dd>
        <% if (booking.email) { %><dt>E-mail</dt><dd><%= booking.email %></dd><% } %>
        <dt>Cão</dt><dd><%= booking.pet_name %> — <%= booking.breed %></dd>
        <dt>Porte</dt><dd><%= labels.size[booking.size] %></dd>
        <dt>Idade</dt><dd><%= booking.age_value %> <%= booking.age_unit %></dd>
        <dt>Castrado</dt><dd><%= labels.yesNo[booking.neutered] %></dd>
        <dt>Sociável</dt><dd><%= labels.sociable[booking.sociable] %></dd>
        <dt>Vacinas em dia</dt><dd><%= labels.yesNo[booking.vaccinated] %></dd>
        <% if (booking.notes) { %><dt>Observações do tutor</dt><dd class="pre"><%= booking.notes %></dd><% } %>
        <dt>Recebido em</dt><dd><%= booking.created_at %></dd>
      </dl>
    </div>

    <form method="post" action="/admin/agendamentos/<%= booking.id %>" class="form card form-card">
      <label>Status
        <select name="status">
          <% Object.keys(labels.status).forEach(function (s) { %>
            <option value="<%= s %>" <%= booking.status === s ? 'selected' : '' %>><%= labels.status[s] %></option>
          <% }) %>
        </select>
      </label>
      <label>Anotações internas (só você vê)
        <textarea name="admin_notes" rows="4" maxlength="1000"><%= booking.admin_notes || '' %></textarea>
      </label>
      <button type="submit" class="btn btn-full">Salvar</button>
    </form>

    <form method="post" action="/admin/agendamentos/<%= booking.id %>/excluir" data-confirm="Excluir este pedido definitivamente?" class="danger-zone">
      <button type="submit" class="btn btn-danger btn-small">Excluir pedido</button>
    </form>
  </div>
</section>

<%- include('../partials/footer') %>
