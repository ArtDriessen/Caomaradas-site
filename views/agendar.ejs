<% const isEval = mode === 'avaliacao'; const isDay = mode === 'dayuse';
   const crumbs = isEval ? [{ label: 'Creche', href: '/servicos/creche' }, { label: 'Agendar avaliação' }]
     : isDay ? [{ label: 'Creche e day use', href: '/servicos/creche' }, { label: 'Agendar day use' }]
     : [{ label: 'Hotel', href: '/servicos/hotel' }, { label: 'Pré-reserva' }]; %>
<%- include('partials/header', { crumbs: crumbs }) %>
<% const f = locals.form || {}; const petList = (f.pets && f.pets.length) ? f.pets : [{}]; %>

<section class="section">
  <div class="container narrow">
    <% if (isEval) { %>
      <h1>Agende uma <span class="hl">avaliação</span> do seu pet</h1>
      <p class="section-sub">Antes de entrar na creche, cada cão passa por uma avaliação. Preencha os dados e a data que prefere: confirmamos o horário com você pelo WhatsApp.</p>
    <% } else if (isDay) { %>
      <h1>Agende o <span class="hl">day use</span> do seu pet</h1>
      <p class="section-sub">Um dia de diversão com a gente, com a mesma segurança da creche. Escolha a data e informe os cães: confirmamos a vaga pelo WhatsApp.</p>
    <% } else { %>
      <h1>Faça sua <span class="hl">pré-reserva</span> no hotel</h1>
      <p class="section-sub">É um pedido de pré-reserva: nós confirmamos a vaga com você pelo WhatsApp. Faça com antecedência para garantir a melhor experiência para o seu pet.</p>
    <% } %>

    <div class="note">
      <strong>Requisitos para os cães:</strong> vacinas em dia (V8/V10 e antirrábica), controle de pulgas e vermes atualizado, cão socializado e castração obrigatória para cães acima de 6 meses.
    </div>

    <% if (locals.errors && errors.length) { %>
      <div class="alert alert-error" role="alert">
        <strong>Confira os campos:</strong>
        <ul><% errors.forEach(function (e) { %><li><%= e %></li><% }) %></ul>
      </div>
    <% } %>

    <form method="post" action="<%= isEval ? '/avaliacao' : isDay ? '/dayuse' : '/agendar' %>" class="form" novalidate data-booking-form data-mode="<%= mode %>" data-hotel-single="<%= pricing.hotel.single %>" data-hotel-multi="<%= pricing.hotel.multi %>" data-dayuse="<%= pricing.dayuse %>" data-max-pets="<%= pricing.maxPets %>">
      <input type="text" name="website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">

      <fieldset>
        <legend><%= isEval || isDay ? 'Data' : 'Datas' %></legend>
        <% if (isEval || isDay) { %>
          <label><%= isDay ? 'Data do day use' : 'Data preferida para a avaliação' %>
            <input type="date" name="check_in" min="<%= today %>" value="<%= f.check_in || '' %>" required>
          </label>
        <% } else { %>
          <div class="grid-2">
            <label>Entrada
              <input type="date" name="check_in" min="<%= today %>" value="<%= f.check_in || '' %>" required>
            </label>
            <label>Saída
              <input type="date" name="check_out" min="<%= today %>" value="<%= f.check_out || '' %>" required>
            </label>
          </div>
        <% } %>
      </fieldset>

      <fieldset>
        <legend>Tutor</legend>
        <div class="grid-2">
          <label>Nome completo
            <input type="text" name="tutor_name" maxlength="120" value="<%= f.tutor_name || '' %>" required>
          </label>
          <label>WhatsApp (com DDD)
            <input type="tel" name="whatsapp" inputmode="tel" placeholder="(41) 99999-9999" maxlength="20" value="<%= f.whatsapp || '' %>" required>
          </label>
        </div>
        <label>E-mail (opcional)
          <input type="email" name="email" maxlength="160" value="<%= f.email || '' %>">
        </label>
      </fieldset>

      <fieldset>
        <legend>Seus cães</legend>
        <div data-pets>
          <% petList.forEach(function (p, idx) { %>
            <%- include('partials/pet-fields', { i: idx, p: p, removable: idx > 0 }) %>
          <% }) %>
        </div>
        <button type="button" class="btn btn-outline btn-small" data-pet-add>+ Adicionar outro cão</button>
        <p class="hint">Você pode cadastrar até <%= pricing.maxPets %> cães do mesmo tutor no mesmo pedido.</p>
        <label>Observações (alimentação, medicamentos, comportamento…)
          <textarea name="notes" rows="4" maxlength="1000"><%= f.notes || '' %></textarea>
        </label>
        <template id="pet-template">
          <%- include('partials/pet-fields', { i: '__i__', p: {}, removable: true }) %>
        </template>
      </fieldset>

      <% if (!isEval) { %>
        <div class="price-box" data-price-box aria-live="polite">
          <% if (isDay) { %>
            <p class="price-line"><span data-price-detail>1 cão × <%= fmtMoney(pricing.dayuse) %></span></p>
          <% } else { %>
            <p class="price-line"><span data-price-detail>Escolha as datas para ver o valor.</span></p>
          <% } %>
          <p class="price-total">Total estimado: <strong data-price-total><%= isDay ? fmtMoney(pricing.dayuse) : '—' %></strong></p>
          <p class="hint">Valor estimado. A confirmação final é feita por nós pelo WhatsApp.<% if (!isDay) { %> Diária de <%= fmtMoney(pricing.hotel.single) %> (1 cão) ou <%= fmtMoney(pricing.hotel.multi) %> por cão a partir do segundo hóspede.<% } %></p>
        </div>
      <% } %>

      <button type="submit" class="btn btn-full"><%= isEval ? 'Pedir avaliação' : isDay ? 'Agendar day use' : 'Enviar pré-reserva' %></button>
    </form>
  </div>
</section>

<%- include('partials/footer') %>
